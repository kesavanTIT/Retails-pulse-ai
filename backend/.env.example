# ─── Application ───────────────────────────────────────────────
APP_NAME=RetailPulse AI
APP_VERSION=1.0.0
DEBUG=true

# ─── Database ──────────────────────────────────────────────────
# SQLite (POC default) — change to PostgreSQL URL for production
DATABASE_URL=sqlite:///./data/retailpulse.db

# ─── ML Model ──────────────────────────────────────────────────
MODEL_DIR=./data/models

# ─── Boomi Integration ─────────────────────────────────────────
BOOMI_SECRET=dev-boomi-secret-change-in-prod

# ─── UKG Pro WFM (OAuth2 Client Credentials) ───────────────────
UKG_BASE_URL=https://your-tenant.ukg.com
UKG_CLIENT_ID=your-ukg-client-id
UKG_CLIENT_SECRET=your-ukg-client-secret
UKG_TOKEN_URL=https://your-tenant.ukg.com/oauth2/token
UKG_FORECAST_PATH=/api/v1/forecasting/demand
UKG_SCHEDULE_PATH=/api/v1/scheduling/shifts

# ─── CORS ──────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
